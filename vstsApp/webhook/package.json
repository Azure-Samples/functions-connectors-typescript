{
  "name": "vstsapp",
  "version": "1.0.0",
  "description": "Azure Functions sample for the Azure DevOps (VSTS) connector using @azure/functions-extensions-connectors",
  "type": "module",
  "main": "dist/functions/*.js",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test ../../tests/samples.test.mjs ../../tests/vsts-setup.test.mjs",
    "watch": "tsc -w",
    "prestart": "npm run build",
    "start": "func start",
    "setup:local": "node infra/scripts/local-settings.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@azure/connectors": "0.4.0-preview",
    "@azure/functions": "^4.17.1",
    "@azure/functions-extensions-connectors": "0.2.0-preview"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.0.0"
  }
}
