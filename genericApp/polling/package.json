    "start": "func start"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@azure/functions": "^4.17.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.0.0"
  }
}
