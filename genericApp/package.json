{
  "name": "genericapp",
  "version": "1.0.0",
  "description": "Azure Functions sample using the generic connectorTrigger<TItem> API from @azure/functions-extensions-connectors — works for any Azure Logic Apps connector, including those without first-class wrappers.",
  "type": "module",
  "main": "dist/functions/*.js",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test ../tests/samples.test.mjs",
    "watch": "tsc -w",
    "prestart": "npm run build",
    "start": "func start"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@azure/connectors": "0.4.0-preview",
    "@azure/functions": "^4.17.0",
    "@azure/functions-extensions-connectors": "0.2.0-preview"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.0.0"
  }
}
