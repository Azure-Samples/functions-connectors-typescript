{
  "name": "dataflowsapp",
  "version": "1.0.0",
  "description": "Azure Functions sample for the Dataflows connector using @azure/functions-extensions-connectors",
  "type": "module",
  "main": "dist/functions/*.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "prestart": "npm run build",
    "start": "func start",
    "setup:local": "node infra/scripts/local-settings.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@azure/connectors": "1.0.0",
    "@azure/functions": "^4.17.1",
    "@azure/functions-extensions-connectors": "1.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.0.0"
  }
}
